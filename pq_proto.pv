(* ================================================================
 *  ProVerif model — PQ handshake protocol (CORRECTED)
 *  ML-KEM-768 + ML-DSA-65 + ChaCha20-Poly1305
 *
 *  Matches the corrected server.c / client.c wire protocol:
 *
 *  HANDSHAKE:
 *    S→C : sig_pk                                (server.c: send_all sig_pk)
 *    S→C : kem_pk                                (server.c: send_all kem_pk)
 *    S→C : ns          [SECURITY-1]              (server.c: send_all ns)
 *    S : transcript = H(sig_pk||kem_pk||ns)      (server.c: compute_transcript_hash)
 *    S→C : Sign(sig_sk, transcript) [SECURITY-2] (server.c: OQS_SIG_sign)
 *    C→S : ML-KEM.Encaps(kem_pk)                 (client.c: OQS_KEM_encaps)
 *
 *  KEY DERIVATION:  [SECURITY-3,4]
 *    Both: ss = KEM shared secret
 *    Both: key_s2c = derive_s2c(ss)  (server→client encryption)
 *    Both: key_c2s = derive_c2s(ss)  (client→server encryption)
 *
 *  DATA PHASE (directional keys + monotonic nonces):
 *    S→C : Enc(key_s2c, nonce_s, msg)  [SECURITY-4]
 *    C→S : Enc(key_c2s, nonce_c, msg)  [SECURITY-4]
 *
 *  WHY THIS FIXES Q8 (injective authentication):
 *    The reflection attack in the original protocol works because
 *    the attacker replays the client's own encrypted message
 *    (key_c2s-encrypted) back to the client. The client decrypts
 *    successfully because key == key (same key both directions).
 *
 *    With directional keys:
 *      - Client encrypts with key_c2s, decrypts with key_s2c
 *      - Reflected key_c2s packets fail decryption with key_s2c
 *      - Only the genuine server (who derived key_s2c via decaps)
 *        can produce messages decryptable with key_s2c
 *      - Therefore each ClientAcceptsServer requires a matching
 *        ServerDerivesKey (injective correspondence)
 *
 *  Expected: ALL 8 queries TRUE.
 * ================================================================ *)


(* ═══════════════════════════════════════════════════════════════
 *  TYPES AND CHANNEL
 * ═══════════════════════════════════════════════════════════════ *)

free c: channel.

type skey.
type pkey.
type ssecret.       (* KEM shared secret                          *)
type ciphertext.
type signature.
type key.           (* 32-byte session key                        *)
type nonce.         (* 12-byte AEAD nonce (from monotonic counter)*)


(* ═══════════════════════════════════════════════════════════════
 *  CRYPTOGRAPHIC PRIMITIVES
 * ═══════════════════════════════════════════════════════════════ *)

(* ── ML-DSA-65 ──────────────────────────────────────────────── *)
(* [SECURITY-2] Signature operates on bitstring (transcript hash)
 * rather than pkey, because the server now signs
 * H(pk_sig || pk_kem || ns) — a hash output. *)
fun sig_pk(skey): pkey.
fun sign(bitstring, skey): signature.
reduc forall m: bitstring, sk: skey;
    verify(sign(m, sk), m, sig_pk(sk)) = true.

(* ── ML-KEM-768 (table-based IND-CCA2 model) ────────────────── *)
(* Client generates fresh ss, computes ct = kem_enc(pk, ss),
 * inserts (ct, ss) into private table.
 * Server retrieves ss by matching ct exactly.
 * Attacker-crafted ciphertexts find no table entry → blocks. *)
fun kem_pk(skey): pkey.
fun kem_enc(pkey, ssecret): ciphertext.
table kem_tbl(ciphertext, ssecret).

(* ── [SECURITY-2] Transcript hash ────────────────────────────── *)
(* Models SHAKE256(pk_sig || pk_kem || ns) from both
 * server.c:compute_transcript_hash and client.c:compute_transcript_hash *)
fun transcript_hash(pkey, pkey, bitstring): bitstring.

(* ── [SECURITY-3,4] Directional KDF ─────────────────────────── *)
(* Models derive_session_keys() which outputs 64 bytes split into:
 *   key_s2c = first 32 bytes (server→client)
 *   key_c2s = last 32 bytes  (client→server)
 * Using two separate functions ensures ProVerif treats them as
 * distinct keys even though they derive from the same ss.
 * The full C code binds "PQ-AKE"||ss||pk_sig||pk_kem||ns||ct
 * but symbolically ss uniqueness is sufficient. *)
fun derive_s2c(ssecret): key.
fun derive_c2s(ssecret): key.

(* ── ChaCha20-Poly1305 AEAD ─────────────────────────────────── *)
(* [SECURITY-5] Nonce is monotonic counter, modeled as fresh name *)
fun aead_enc(key, nonce, bitstring): bitstring.
reduc forall k: key, n: nonce, m: bitstring;
    aead_dec(aead_enc(k, n, m), k, n) = m.


(* ═══════════════════════════════════════════════════════════════
 *  SECRECY QUERIES
 * ═══════════════════════════════════════════════════════════════ *)

free session_key_secret: key [private].
free secret_message: bitstring [private].
free kem_shared_secret: ssecret [private].

(* Q1 *) query attacker(session_key_secret).
(* Q2 *) query attacker(secret_message).
(* Q3 *) query attacker(kem_shared_secret).


(* ═══════════════════════════════════════════════════════════════
 *  EVENTS
 * ═══════════════════════════════════════════════════════════════ *)

event ServerSendsAuth(pkey, pkey, signature).
event ClientVerifiesAuth(pkey, pkey).
event ClientSendsCiphertext(ciphertext).
event ServerDecapsCiphertext(ciphertext).
event ServerDerivesKey(key).
event ClientDerivesKey(key).
event ServerAcceptsClient(pkey, key).
event ClientAcceptsServer(pkey, key).
event SessionEstablished(key, pkey, pkey).
event MessageSent(key, bitstring).
event MessageReceived(key, bitstring).


(* ═══════════════════════════════════════════════════════════════
 *  CORRESPONDENCE QUERIES
 * ═══════════════════════════════════════════════════════════════ *)

(* Q4: Server authentication *)
query spk: pkey, k: key, kpk: pkey, s: signature;
    event(ClientAcceptsServer(spk, k))
    ==> event(ServerSendsAuth(spk, kpk, s)).

(* Q5: Client liveness *)
query kpk: pkey, k: key, ct2: ciphertext;
    event(ServerAcceptsClient(kpk, k))
    ==> event(ClientSendsCiphertext(ct2)).

(* Q6: Key agreement *)
query k: key, spk: pkey, kpk: pkey;
    event(ClientDerivesKey(k)) && event(ServerDerivesKey(k))
    ==> event(SessionEstablished(k, spk, kpk)).

(* Q7: Message authenticity *)
query k: key, m: bitstring;
    event(MessageReceived(k, m)) ==> event(MessageSent(k, m)).

(* Q8: INJECTIVE server authentication.
 * This query failed in the original protocol because the attacker
 * could reflect client messages. With directional keys, it succeeds:
 * each ClientAcceptsServer maps to exactly one ServerDerivesKey. *)
query spk: pkey, k: key;
    inj-event(ClientAcceptsServer(spk, k))
    ==> inj-event(ServerDerivesKey(k)).


(* ═══════════════════════════════════════════════════════════════
 *  SERVER PROCESS
 *
 *  server.c: authenticate_client()
 *            send_to_client()       — uses key_s2c
 *            client_handler recv    — uses key_c2s
 * ═══════════════════════════════════════════════════════════════ *)

let Server(sk_sig: skey, pk_sig_pub: pkey) =

    (* server.c: ML-KEM keypair generation *)
    new sk_kem: skey;
    let pk_kem: pkey = kem_pk(sk_kem) in

    (* [SECURITY-1] server.c: Generate fresh session nonce ns *)
    new ns: bitstring;

    (* server.c: send sig_pk, kem_pk, ns *)
    out(c, pk_sig_pub);
    out(c, pk_kem);
    out(c, ns);

    (* [SECURITY-2] server.c: compute_transcript_hash + sign *)
    let th: bitstring = transcript_hash(pk_sig_pub, pk_kem, ns) in
    let sig_val: signature = sign(th, sk_sig) in
    event ServerSendsAuth(pk_sig_pub, pk_kem, sig_val);

    (* server.c: send signature *)
    out(c, sig_val);

    (* server.c: receive ciphertext *)
    in(c, ct: ciphertext);
    event ServerDecapsCiphertext(ct);

    (* server.c: ML-KEM decapsulation (table-based) *)
    get kem_tbl(=ct, ss: ssecret) in

    (* [SECURITY-3,4] server.c: derive_session_keys
     * key_s2c for sending, key_c2s for receiving *)
    let key_s2c: key = derive_s2c(ss) in
    let key_c2s: key = derive_c2s(ss) in

    event SessionEstablished(key_s2c, pk_sig_pub, pk_kem);
    event ServerDerivesKey(key_s2c);
    event ServerAcceptsClient(pk_kem, key_s2c);

    (* server.c:send_to_client — encrypt with key_s2c *)
    new nonce_s: nonce;
    new server_msg: bitstring;
    event MessageSent(key_s2c, server_msg);
    let enc_s: bitstring = aead_enc(key_s2c, nonce_s, server_msg) in
    out(c, (nonce_s, enc_s));

    (* server.c:client_handler — decrypt with key_c2s *)
    in(c, (nonce_c: nonce, enc_c: bitstring));
    let dec_c: bitstring = aead_dec(enc_c, key_c2s, nonce_c) in
    event MessageReceived(key_c2s, dec_c).


(* ═══════════════════════════════════════════════════════════════
 *  CLIENT PROCESS
 *
 *  client.c: authenticate()
 *            send_encrypted()   — uses key_c2s
 *            receiver()         — uses key_s2c
 *
 *  ClientAcceptsServer fires AFTER successful decryption with
 *  key_s2c (key confirmation). This is the critical ordering
 *  for Q8: the client only "accepts" after proving the server
 *  derived the matching key_s2c.
 * ═══════════════════════════════════════════════════════════════ *)

let Client(trusted_pk_sig: pkey) =

    (* client.c: receive sig_pk *)
    in(c, received_pk_sig: pkey);

    (* Trust anchor check (models pre-shared server_pk.bin) *)
    if received_pk_sig = trusted_pk_sig then

    (* client.c: receive kem_pk *)
    in(c, pk_kem: pkey);

    (* [SECURITY-1] client.c: receive session nonce ns *)
    in(c, ns: bitstring);

    (* client.c: receive signature *)
    in(c, sig_rcv: signature);

    (* [SECURITY-2] client.c: compute_transcript_hash + verify
     * Verify the signature against H(pk_sig || pk_kem || ns).
     * This binds identity + ephemeral key + session freshness. *)
    let th: bitstring = transcript_hash(trusted_pk_sig, pk_kem, ns) in
    if verify(sig_rcv, th, trusted_pk_sig) = true then
    event ClientVerifiesAuth(trusted_pk_sig, pk_kem);

    (* client.c: ML-KEM encapsulation *)
    new ss: ssecret;
    let ct: ciphertext = kem_enc(pk_kem, ss) in
    insert kem_tbl(ct, ss);
    event ClientSendsCiphertext(ct);

    (* client.c: send ciphertext *)
    out(c, ct);

    (* [SECURITY-3,4] client.c: derive_session_keys
     * key_s2c for receiving, key_c2s for sending *)
    let key_s2c: key = derive_s2c(ss) in
    let key_c2s: key = derive_c2s(ss) in

    event SessionEstablished(key_s2c, trusted_pk_sig, pk_kem);
    event ClientDerivesKey(key_s2c);

    (* client.c:send_encrypted — encrypt with key_c2s *)
    new nonce_c: nonce;
    new client_msg: bitstring;
    event MessageSent(key_c2s, client_msg);
    let enc_c: bitstring = aead_enc(key_c2s, nonce_c, client_msg) in
    out(c, (nonce_c, enc_c));

    (* client.c:receiver — decrypt with key_s2c.
     * KEY CONFIRMATION: Only the genuine server can encrypt with
     * key_s2c (derived from decaps). If decryption succeeds, the
     * server must have participated in this exact session.
     *
     * [CRITICAL FOR Q8] ClientAcceptsServer fires ONLY after
     * successful decryption. The attacker cannot trigger this
     * by reflecting enc_c back because enc_c uses key_c2s but
     * the client decrypts with key_s2c (different key → fails). *)
    in(c, (nonce_s: nonce, enc_s: bitstring));
    let dec_s: bitstring = aead_dec(enc_s, key_s2c, nonce_s) in
    event MessageReceived(key_s2c, dec_s);

    event ClientAcceptsServer(trusted_pk_sig, key_s2c).


(* ═══════════════════════════════════════════════════════════════
 *  MAIN PROCESS
 * ═══════════════════════════════════════════════════════════════ *)

process
    (* server.c:main — generate long-term ML-DSA keypair *)
    new sk_sig: skey;
    let pk_sig: pkey = sig_pk(sk_sig) in

    (* pk_sig is public — attacker can read but not substitute *)
    out(c, pk_sig);

    (* Unbounded parallel sessions *)
    (  !Server(sk_sig, pk_sig)
     | !Client(pk_sig)  )
